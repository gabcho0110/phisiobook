rules_version = '2';

// PhysioBook — Firebase Storage rules.
// Security posture matches the rest of the app: writes/reads require an
// authenticated user. (Role-based restrictions are enforced client-side only,
// consistent with the RTDB rules.) Exercise media is uploaded under
// clinics/{clinicId}/exercises/{exerciseId}/media/{file}.
service firebase.storage {
  match /b/{bucket}/o {
    // Exercise media uploads
    match /clinics/{clinicId}/exercises/{exerciseId}/media/{fileName} {
      allow read, write: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
    }

    // Fallback: any authenticated user may read/write anywhere in the bucket.
    // Keep this in place so other future Storage uses are not blocked.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
